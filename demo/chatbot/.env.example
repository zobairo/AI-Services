# Copy to .env and fill in, or just export these in your shell.
# The demo runs without any of them (mock mode).

# Real answers instead of mock mode
ANTHROPIC_API_KEY=

# Model tier. Use a cheaper/faster tier for high-volume simple bots,
# a stronger one where answers need more care. See docs/03 for cost math.
ANTHROPIC_MODEL=claude-sonnet-5

# Per-client branding
BUSINESS_NAME=Northside Dental Clinic
HANDOFF_MESSAGE=I do not want to guess on this one. I am passing you to a team member who will reply here shortly.

PORT=3000
