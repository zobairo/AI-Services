# The chatbot service has no dependencies, so this image is tiny and builds
# in seconds. Build context is the repo root (see docker-compose.yml).
FROM node:22-alpine

WORKDIR /app

COPY demo/chatbot/package.json ./demo/chatbot/package.json
COPY demo/chatbot/src ./demo/chatbot/src
COPY demo/chatbot/public ./demo/chatbot/public
COPY demo/chatbot/knowledge ./demo/chatbot/knowledge
COPY demo/chatbot/test-cases.json ./demo/chatbot/test-cases.json

# Run as a non-root user.
RUN chown -R node:node /app
USER node

WORKDIR /app/demo/chatbot
EXPOSE 3000

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/server.js"]
