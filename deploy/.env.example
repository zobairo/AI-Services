# Copy to .env and fill in every value. Compose will refuse to start if any
# required one is missing — that is deliberate, an empty secret is worse than
# a failed boot. Never commit .env.

# Hostnames (A records must already point at this server)
N8N_HOST=n8n.yourdomain.com
CHATBOT_HOST=chat.yourdomain.com

# The website the chat widget is embedded in — used for CORS.
CLIENT_WEBSITE_ORIGIN=https://clientdomain.com

# n8n admin login
N8N_USER=admin
N8N_PASSWORD=

# Encrypts stored credentials inside n8n. Generate once, back it up in your
# password manager, and never change it:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Which client this chatbot container serves.
# Default demo: /app/demo/chatbot   ·   A real client: /app/clients/<slug>
CLIENT_DIR=/app/demo/chatbot

TIMEZONE=Europe/London
